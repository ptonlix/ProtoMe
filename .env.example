# ProtoMe 环境变量示例
# 复制为 .env.local 后再填写真实值

# 可选：指定私有内容工作区目录
# 系统会自动读取该目录下的 data/ 与 public/
# PROTOME_CONTENT_WORKSPACE=.protome-workspace

# =========================
# 后台管理必需配置
# =========================

NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:4100
PROTOME_ADMIN_API_PORT=4100
ADMIN_APP_ORIGIN=http://localhost:3000
PROTOME_ADMIN_KEY=your-admin-key
PROTOME_PUBLISH_RESTART_CMD=echo "restart skipped in local"

# 可选：后台上传大小限制，单位字节
# PROTOME_ADMIN_MAX_UPLOAD_BYTES=20971520

# =========================
# 评论系统（可选，giscus）
# =========================

NEXT_PUBLIC_GISCUS_REPO=owner/repo
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=your-giscus-repository-id
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=your-giscus-category-id

# =========================
# 邮件订阅（可选，buttondown）
# =========================

BUTTONDOWN_API_KEY=your-buttondown-api-key

# =========================
# 站点构建（可选）
# =========================

# BASE_PATH=
# EXPORT=
# UNOPTIMIZED=
# NEXT_DIST_DIR=.next
# ANALYZE=false
# NEXT_UMAMI_ID=

# =========================
# Profile API（可选）
# =========================

# PROTOME_PROFILE_API_PORT=4200
# PROFILE_API_ORIGIN=http://localhost:3000
# PROFILE_API_SNAPSHOT_DIR=deploy/snapshots
# PROTOME_PROFILE_API_ACCESS_KEY=your-profile-api-access-key
