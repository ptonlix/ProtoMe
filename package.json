{
  "name": "protome-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter protome-web dev",
    "dev:api": "pnpm --filter protome-api dev",
    "dev:profile-api": "pnpm --filter protome-profile-api dev",
    "dev:workspace": "concurrently \"pnpm dev\" \"pnpm dev:api\"",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:api\"",
    "build": "pnpm --filter protome-web build",
    "build:api": "pnpm --filter protome-api build",
    "build:profile-api": "pnpm --filter protome-profile-api build",
    "build:cli": "pnpm --filter protome-cli build",
    "build:snapshots": "node ./scripts/build-snapshots.mjs",
    "build:cloud": "pnpm build && pnpm build:profile-api && pnpm build:snapshots",
    "build:workspace": "pnpm build && pnpm build:api",
    "build:all": "pnpm build && pnpm build:api && pnpm build:profile-api && pnpm build:cli",
    "serve": "pnpm --filter protome-web serve",
    "serve:api": "pnpm --filter protome-api start",
    "serve:profile-api": "pnpm --filter protome-profile-api start",
    "serve:cloud": "node ./scripts/start-cloud.mjs",
    "lint": "pnpm --filter protome-web lint && pnpm --filter protome-api lint && pnpm --filter protome-profile-api lint && pnpm --filter protome-cli lint",
    "typecheck": "pnpm --filter protome-web typecheck && pnpm --filter protome-api typecheck && pnpm --filter protome-profile-api typecheck && pnpm --filter protome-cli typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.18.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "github-slugger": "^2.0.0",
    "globals": "^17.3.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "pliny": "0.4.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "src/**/*.+(js|jsx|ts|tsx)": [
      "pnpm --dir src exec eslint --fix"
    ],
    "src-api/**/*.+(js|jsx|ts|tsx)": [
      "pnpm --dir src-api exec eslint --fix"
    ],
    "src-profile-api/**/*.+(js|jsx|ts|tsx)": [
      "pnpm --dir src-profile-api exec eslint --fix"
    ],
    "packages/**/*.+(js|jsx|ts|tsx)": [
      "pnpm --dir packages/protome-cli exec eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "pnpm exec prettier --write"
    ]
  },
  "packageManager": "pnpm@10.28.1"
}
